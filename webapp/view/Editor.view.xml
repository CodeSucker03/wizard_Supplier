<mvc:View
    controllerName="fioricert.controller.Editor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    xmlns="sap.m"
    height="100%"
    xmlns:layout="sap.ui.layout"
    xmlns:uxap="sap.uxap"
    xmlns:unified="sap.ui.unified"
>
    <Page title="{i18n>title}">
        <content>
            <unified:FileUploader
                id="fileUploader"
                name="fileUploader"
                tooltip="Upload your file"
                sameFilenameAllowed="true"
                change="handleUploadChange"
            />
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
