<mvc:View
    controllerName="fioricert.controller.Editor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    xmlns="sap.m"
    height="100%"
    xmlns:layout="sap.ui.layout"
    xmlns:uxap="sap.uxap"
    xmlns:unified="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
>
    <Page id="pageId" title="{i18n>title}">
        <content>
            <unified:FileUploader
                id="fileUploader"
                name="fileUploader"
                tooltip="Upload your file"
                sameFilenameAllowed="true"
                change="handleUploadChange"
            />
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout />
                </f:layout>
                <f:FormContainer title="Certificate Information">
                    <f:FormElement label="Mã chứng chỉ">
                        <FlexBox direction="Column"
                            items="{
                path:'certificateModel>/content',
                factory:'.inputFactory'
              }">

                        </FlexBox>
                    </f:FormElement>

                </f:FormContainer>
            </f:Form>


            <core:HTML id="htmlString" content="{certificateModel>/htmlString}">

            </core:HTML>

        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Save" press="onEditRow" type="Emphasized" />
                <Button text="Interpolate" press="handleInterpolate" type="Emphasized" />
                <Button text="PDF Preview" press="handlePDFPreview" type="Emphasized" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>