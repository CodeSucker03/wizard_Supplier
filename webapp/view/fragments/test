       <VBox class="sapUiSmallMarginBottom">
            <Title text="THÔNG TIN NGƯỜI ĐẠI DIỆN" />
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="45%">
                    <Label
                        text="Danh xưng"
                        required="true"
                    />
                    <Select selectedKey="{path:'accModel>/NddTitle'}">
                        <core:Item
                            key="1"
                            text="Ông"
                        />
                        <core:Item
                            key="2"
                            text="Bà"
                        />
                    </Select>
                </VBox>
                <VBox width="45%">
                    <Label
                        text="Họ và tên"
                        required="true"
                    />
                    <Input
                        liveChange="validateHoTen"
                        id="hoten"
                        value="{
                                 path:'accModel>/NddHoten',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:255}}"
                    />
                </VBox>
            </HBox>
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="45%">
                    <Label
                        text="Quốc tịch"
                        required="true"
                    />
                    <Select selectedKey="{path:'accModel>/NddNationality'}">
                        <core:Item
                            key="Việt Nam"
                            text="Việt Nam"
                        />
                        <core:Item
                            key="Nước khác"
                            text="Nước khác"
                        />
                    </Select>
                </VBox>
                <VBox width="45%">
                    <Label
                        text="Số định danh"
                        required="true"
                    />
                    <Input
                        liveChange="validateSdd"
                        id="sodinhdanh"
                        type="Number"
                        value="{
                                 path:'accModel>/NddIdnumber',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:12,
                                 maxLength:12}}"
                    />
                </VBox>
            </HBox>
        </VBox>
        <VBox class="sapUiSmallMarginBottom">
            <Title text="THÔNG TIN LIÊN HỆ" />
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="30%">
                    <Label
                        text="Danh xưng"
                        required="true"
                    />
                    <Select selectedKey="{path:'accModel>/DmTitle'}">
                        <core:Item
                            key="1"
                            text="Ông"
                        />
                        <core:Item
                            key="2"
                            text="Bà"
                        />
                    </Select>
                </VBox>
                <VBox width="30%">
                    <Label
                        text="Họ và tên"
                        required="true"
                    />
                    <Input
                        liveChange="validateFullname"
                        id="fullName"
                        value="{
                                 path:'accModel>/DmHoten',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:255}}"
                    />
                </VBox>
                <VBox width="30%">
                    <Label
                        text="Chức vụ"
                        required="true"
                    />
                    <Input
                        liveChange="validateChucVu"
                        id="chucvu"
                        value="{
                                 path:'accModel>/DmChucvu',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:255}}"
                    />
                </VBox>
            </HBox>
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="45%">
                    <Label
                        text="Số điện thoại"
                        required="true"
                    />
                    <Input
                        type="Number"
                        liveChange="validateSdt"
                        id="sdt"
                        value="{
                                 path:'accModel>/DmSdt',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:10,
                                 maxLength:10}}"
                    />
                </VBox>
                <VBox width="45%">
                    <Label
                        text="Email"
                        required="true"
                    />
                    <Input
                        change="changeEmail"
                        liveChange="validateEmail"
                        id="email"
                        value="{
                                 path:'accModel>/DmEmail',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:255}}"
                    />
                </VBox>
            </HBox>
            <Label text="Nguồn giới thiệu" />
            <Input
                liveChange="validateNguoiGt"
                id="nguoiGioithieu"
                value="{accModel>/Gioithieu}"
            />
        </VBox>