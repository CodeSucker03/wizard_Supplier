                                 path:'accModel>/DtAmount2',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:15}}"
                        />
                    </VBox>
                    <VBox width="5%" />
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="năm"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="nam3"
                            liveChange="validateNam2"
                            value="{
                                 path:'accModel>/DtYear3',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:4}}"
                        />
                    </VBox>
                    <VBox width="45%">
                        <Label
                            text="giá trị"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="gt3"
                            liveChange="validateGiatri2"
                            value="{
                                 path:'accModel>/DtAmount3',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:15}}"
                        />
                    </VBox>
                    <VBox width="5%" />
                </HBox>
            </VBox>
            <VBox class="customVBoxSpacing">
                <Title text="Lợi nhuận 3 năm" />
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="năm"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="nam4"
                            liveChange="validateNam4"
                            value="{
