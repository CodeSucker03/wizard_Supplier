                        />
                    </VBox>
                    <VBox width="5%" />
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="năm"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="nam6"
                            liveChange="validateNam6"
                            value="{
                                 path:'accModel>/LnYear3',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
