                    <VBox width="45%">
                        <Label
                            text="giá trị"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="gt4"
                            liveChange="validateGiatri1"
                            value="{
                                 path:'accModel>/LnAmount1',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:15}}"
                        />
                    </VBox>
                    <VBox width="5%" />
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="năm"
                            required="true"
                        />
                        <Input
                            required="true"
                            type="Number"
                            id="nam5"
                            liveChange="validateNam5"
                            value="{
                                 path:'accModel>/LnYear2',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
