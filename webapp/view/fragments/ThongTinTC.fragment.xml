                        />
                    </VBox>
                    <VBox width="5%" />
                </HBox>
            </VBox>
            <VBox class="customVBoxSpacing">
                <VBox>
                    <HBox>
                        <VBox>
                            <Input
                                required="true"
                                value="{accModel>/Otp}"
                                id="otp"
                            />
                        </VBox>
                        <VBox>
                            <Button
                                type="Emphasized"
                                text="Lấy mã OTP"
                                press="getOtp"
                            />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </form:SimpleForm>
</core:FragmentDefinition>
