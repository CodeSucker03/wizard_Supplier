<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <MessageStrip
        text="Đã có tài khoản?"
        type="Information"
        showIcon="true"
    >
        <Link
            text="Login"
            press="openLogin"
        />
    </MessageStrip>
    <form:SimpleForm
        id="formVendorInfo"
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanL="12"
        labelSpanM="12"
        columnsL="12"
        columnsM="12"
        singleContainerFullSize="true"
        binding="{accModel>/}"
    >
        <VBox>
            <VBox
                width="100%"
                class="sapUiSmallMarginBottom"
            >
                <Title text="CHỌN TÊN TÀI KHOẢN" />
                <Label
                    text="Tên tài khoản"
                    required="true"
                />
                <HBox width="100%">
                    <VBox width="30%">
                        <Input
                            valueStateText="Phải nhập đúng định dạng"
                            id="tenTaiKhoan"
                            required="true"
                            liveChange="validateTenTk"
                            value="{
                                 path:'accModel>Username',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                    minLength:3,
                                    maxLength:255}}"
                        />
                    </VBox>
                    <VBox
                        width="70%"
                        class="sapUiSmallMarginBegin"
                    />
                </HBox>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
                <Title text="THÔNG TIN NHÀ CUNG CẤP" />
                <Label
                    text="Tên công ty"
                    required="true"
                />
                <Input
                    liveChange="validateTenCty"
                    id="tenCongty"
                    required="true"
                    value="{
                        path:'accModel>CompanyName',
                        type:'sap.ui.model.type.String'
                        }"
                />
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="Mã số thuế"
                            required="true"
                        />
                        <Input
                            type="Text"
                            liveChange="validateMst"
                            required="true"
                            id="masothue"
                            value="{
                                 path:'accModel>Taxnumber',
                                 type:'.dataType.FieldVNTaxID'
                                }"
                        />
                    </VBox>
                    <VBox width="45%">
                        <Label
                            text="Ngày thành lập"
                            required="true"
                        />
                        <DatePicker
                            id="ngayThanhLap"
                            required="true"
                            value="{accModel>Thanhlap}"
                            displayFormat="dd-MM-yyyy"
                        />
                    </VBox>
                </HBox>
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="Địa chỉ"
                            required="true"
                        />
                        <Input
                            liveChange="validateDiachi"
                            id="diachi"
                            required="true"
                            value="{
                                 path:'accModel>CompanyAddress',
                                 type:'sap.ui.model.type.String'
                                 }"
                        />
                    </VBox>
                    <VBox width="45%">
                        <Label text="Website" />
                        <Input
                            maxLength="1024"
                            id="website"
                            value="{accModel>Website}"
                        />
                    </VBox>
                </HBox>
            </VBox>
            -->
            <VBox class="sapUiSmallMarginBottom">
                <Title text="THÔNG TIN NGƯỜI ĐẠI DIỆN" />
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="Danh xưng"
                            required="true"
                        />
                        <Select selectedKey="{path:'accModel>NddTitle'}">
                            <core:Item
                                key="1"
                                text="Ông"
                            />
                            <core:Item
                                key="2"
                                text="Bà"
                            />
                        </Select>
                    </VBox>
                    <VBox width="45%">
                        <Label
                            text="Họ và tên"
                            required="true"
                        />
                        <Input
                            liveChange="validateHoTen"
                            id="hoten"
                            required="true"
                            value="{
                                 path:'accModel>NddHoten',
                                 type:'sap.ui.model.type.String'
                                 }"
                        />
                    </VBox>
                </HBox>
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="Quốc tịch"
                            required="true"
                        />
                        <Select selectedKey="{path:'accModel>NddNationality'}">
                            <core:Item
                                key="Việt Nam"
                                text="Việt Nam"
                            />
                            <core:Item
                                key="Nước khác"
                                text="Nước khác"
                            />
                        </Select>
                    </VBox>
                    <VBox width="45%">
                        <Label
                            text="Số định danh"
                            required="true"
                        />
                        <Input
                            liveChange="validateSdd"
                            id="sodinhdanh"
                            type="Number"
                            required="true"
                            value="{
                                 path:'accModel>NddIdnumber',
                                 type:'.dataType.FieldNationalID'
                                 }"
                        />
                    </VBox>
                </HBox>
            </VBox>
            <VBox class="sapUiSmallMarginBottom">
                <Title text="THÔNG TIN LIÊN HỆ" />
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="30%">
                        <Label
                            text="Danh xưng"
                            required="true"
                        />
                        <Select selectedKey="{path:'accModel>DmTitle'}">
                            <core:Item
                                key="1"
                                text="Ông"
                            />
                            <core:Item
                                key="2"
                                text="Bà"
                            />
                        </Select>
                    </VBox>
                    <VBox width="30%">
                        <Label
                            text="Họ và tên"
                            required="true"
                        />
                        <Input
                            liveChange="validateFullname"
                            id="fullName"
                            required="true"
                            value="{
                                 path:'accModel>DmHoten',
                                 type:'sap.ui.model.type.String'
                                 }"
                        />
                    </VBox>
                    <VBox width="30%">
                        <Label
                            text="Chức vụ"
                            required="true"
                        />
                        <Input
                            liveChange="validateChucVu"
                            id="chucvu"
                            required="true"
                            value="{
                                 path:'accModel>DmChucvu',
                                 type:'sap.ui.model.type.String'
                                 }"
                        />
                    </VBox>
                </HBox>
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="45%">
                        <Label
                            text="Số điện thoại"
                            required="true"
                        />
                        <Input
                            type="Number"
                            liveChange="validateSdt"
                            id="sdt"
                            required="true"
                            value="{
                                 path:'accModel>DmSdt',
                                 type:'.dataType.FieldPhone'
                                 }"
                        />
                    </VBox>
                    <VBox width="45%">
                        <Label
                            text="Email"
                            required="true"
                        />
                        <Input
                            change="changeEmail"
                            liveChange="validateEmail"
                            id="email"
                            required="true"
                            value="{
                                 path:'accModel>DmEmail',
                                 type:'.dataType.FieldEmail'
                                 }"
                        />
                    </VBox>
                </HBox>
                <Label text="Nguồn giới thiệu" />
                <Input
                    liveChange="validateNguoiGt"
                    id="nguoiGioithieu"
                    value="{accModel>Gioithieu}"
                />
            </VBox>
        </VBox>
    </form:SimpleForm>
</core:FragmentDefinition>
