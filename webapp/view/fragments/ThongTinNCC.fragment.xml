<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <MessageStrip
        text="Đã có tài khoản?"
        type="Information"
        showIcon="true"
    >
        <Link
            text="Login"
            press="openLogin"
        />
    </MessageStrip>
    <form:SimpleForm
        id="formVendorInfo"
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanL="12"
        labelSpanM="12"
        columnsL="12"
        columnsM="12"
        singleContainerFullSize="true"
    />
    <VBox>
        <VBox
            width="100%"
            class="sapUiSmallMarginBottom"
        >
            <Title text="CHỌN TÊN TÀI KHOẢN" />
            <Label
                text="Tên tài khoản"
                required="true"
            />
            <HBox width="100%">
                <VBox width="30%">
                    <Input
                        valueStateText="Phải nhập đúng định dạng"
                        id="tenTaiKhoan"
                        required="true"
                        liveChange="validateTenTk"
                        value="{
                                 path:'accModel>/Username',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:3,
                                 maxLength:255}}"
                    />
                </VBox>
                <VBox
                    width="70%"
                    class="sapUiSmallMarginBegin"
                />
            </HBox>
        </VBox>
        <VBox class="sapUiSmallMarginBottom">
            <Title text="THÔNG TIN NHÀ CUNG CẤP" />
            <Label
                text="Tên công ty"
                required="true"
            />
            <Input
                liveChange="validateTenCty"
                id="tenCongty"
                required="true"
                value="{
                        path:'accModel>/CompanyName',
                        type:'sap.ui.model.type.String',
                        constraints:{
                        minLength:1,
                        maxLength:255}}"
            />
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="45%">
                    <Label
                        text="Mã số thuế"
                        required="true"
                    />
                    <Input
                        type="Text"
                        required="true"
                        liveChange="validateMst"
                        id="masothue"
                        value="{
                                 path:'accModel>/Taxnumber',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:10,
                                 maxLength:15}}"
                    />
                </VBox>
                <VBox width="45%">
                    <Label
                        text="Ngày thành lập"
                        required="true"
                    />
                    <DatePicker
                        id="ngayThanhLap"
                        value="{accModel>/Thanhlap}"
                        displayFormat="dd-MM-yyyy"
                    />
                </VBox>
            </HBox>
            <HBox
                width="100%"
                justifyContent="SpaceBetween"
            >
                <VBox width="45%">
                    <Label
                        text="Địa chỉ"
                        required="true"
                    />
                    <Input
                        liveChange="validateDiachi"
                        required="true"
                        id="diachi"
                        value="{
                                 path:'accModel>/CompanyAddress',
                                 type:'sap.ui.model.type.String',
                                 constraints:{
                                 minLength:1,
                                 maxLength:255}}"
                    />
                </VBox>
                <VBox width="45%">
                    <Label text="Website" />
                    <Input
                        maxLength="1024"
                        id="website"
                        value="{accModel>/Website}"
                    />
                </VBox>
            </HBox>
        </VBox>
